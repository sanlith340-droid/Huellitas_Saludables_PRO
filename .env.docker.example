# Puerto publicado por el frontend/Nginx
APP_PORT=8080

# PostgreSQL
DB_NAME=proyectohs
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-password
DB_NAME_TEST=proyectohs_test

# Backend
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-jwt-secret
CORS_ORIGIN=*

# La SPA usa el proxy interno de Nginx; no hace falta cambiarlo normalmente
VITE_API_URL=/api

# true carga los datos demo de back/seeders en el primer arranque
DB_SEED=false
# Recuperación de contraseña (si falta SMTP, la ruta responde 503)
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# URL pública con la que el usuario abre el enlace del correo
FRONTEND_URL=http://localhost:8080
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario-smtp
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=Huellitas Saludables <no-reply@example.com>
