# Puerto publicado por el frontend/Nginx
APP_PORT=8080

# PostgreSQL
DB_NAME=proyectohs
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-password
DB_NAME_TEST=proyectohs_test

# Backend
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-jwt-secret
CORS_ORIGIN=*

# La SPA usa el proxy interno de Nginx; no hace falta cambiarlo normalmente
VITE_API_URL=/api

# true carga los datos demo de back/seeders en el primer arranque
DB_SEED=false
