# Puerto publicado por el frontend/Nginx
APP_PORT=8080

# PostgreSQL
DB_NAME=proyectohs
DB_USER=postgres
DB_PASSWORD=CAMBIAR_POR_UNA_PASSWORD_LOCAL_SEGURA
DB_NAME_TEST=proyectohs_test

# Backend
NODE_ENV=production
# En producción se muestran menos detalles de error; usa development solo en local.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_UNICO
JWT_EXPIRES_IN=10h
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# La SPA usa el proxy interno de Nginx; no hace falta cambiarlo normalmente
VITE_API_URL=/api

# true carga los datos demo de back/seeders en el primer arranque
DB_SEED=false
