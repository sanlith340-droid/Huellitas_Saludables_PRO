# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de datos PostgreSQL (huellitas_saludables) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=proyectohs
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-password

# --- CORS (orígenes exactos separados por comas; no usar *) ---
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# --- JWT (autenticación) ---
JWT_EXPIRES_IN=10h
JWT_SECRET=replace-with-a-long-random-jwt-secret

# --- Render / URL completa de PostgreSQL (opcional) ---
# DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/BASE?sslmode=require

# --- Contraseñas (opcional) ---
# Rondas de salt de bcrypt. Por defecto 12; valores fuera de 10-15 se ignoran.
# BCRYPT_SALT_ROUNDS=12
