# --- Servidor ---
PORT=3000
NODE_ENV=development
# Límite por IP para login y registro (ventana fija de 15 minutos).
AUTH_RATE_LIMIT_MAX=5
# Déjalo sin definir si el backend recibe directamente las solicitudes.
# Si hay proxy inverso, indica el número exacto de saltos confiables (p. ej. 1).
# TRUST_PROXY=

# --- Base de datos PostgreSQL (huellitas_saludables) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=proyectohs
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-password

# --- CORS (orígenes exactos separados por comas; no usar *) ---
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# --- JWT (autenticación) ---
JWT_EXPIRES_IN=10h
JWT_SECRET=replace-with-a-long-random-jwt-secret

# --- Render / URL completa de PostgreSQL (opcional) ---
# DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/BASE?sslmode=require

# --- Contraseñas (opcional) ---
# Rondas de salt de bcrypt. Por defecto 12; valores fuera de 10-15 se ignoran.
# BCRYPT_SALT_ROUNDS=12

# --- Recuperación de contraseña ---
# TTL del enlace de un solo uso; si falta o es inválido se usan 30 minutos.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# URL pública del frontend, sin barra final. Nunca incluir credenciales.
FRONTEND_URL=http://localhost:5173
# SMTP real: no usar valores simulados en desarrollo compartido.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario-smtp
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=Huellitas Saludables <no-reply@example.com>
