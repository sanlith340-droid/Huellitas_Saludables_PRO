# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de datos PostgreSQL (huellitas_saludables) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=proyectohs
DB_USER=postgres
DB_PASSWORD=CAMBIAR_POR_UNA_PASSWORD_LOCAL_SEGURA

# --- CORS (orígenes exactos separados por comas; no usar *) ---
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# --- JWT (autenticación) ---
JWT_EXPIRES_IN=10h
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_UNICO

# --- Render / URL completa de PostgreSQL (opcional) ---
# DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/BASE?sslmode=require
