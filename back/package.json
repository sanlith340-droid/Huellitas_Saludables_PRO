{
  "name": "backend-huellitas",
  "version": "1.0.0",
  "description": "API para gestión de veterinaria Huellitas Saludables",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "tsx server.js",
    "dev": "nodemon --watch server.js --watch app --ext js,ts,json --exec tsx server.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "migrate": "tsx prisma/baseline-if-existing.js && prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "migrate:status": "prisma migrate status",
    "migrate:baseline": "prisma migrate resolve --applied 0_init",
    "seed": "prisma db seed",
    "passwords:migrate": "tsx prisma/migrar-contrasenas-bcrypt.js",
    "db:reset": "prisma migrate reset --force",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "joi": "^17.13.6",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.12",
    "cross-env": "^10.1.0",
    "nodemon": "^3.0.1",
    "prisma": "^7.10.1",
    "supertest": "^7.2.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "qs": "^6.16.0",
    "uuid": "^11.1.1"
  }
}
