{
  "name": "huellitas-saludables-backend",
  "version": "1.0.0",
  "description": "Modulo de Citas + Disponibilidad - Huellitas Saludables (sin ORM, PostgreSQL directo)",
  "main": "back/app/server.js",
  "scripts": {
    "start": "node back/app/server.js",
    "dev": "nodemon back/app/server.js",
    "install:front": "npm install --prefix veterinaria-frontend/veterinaria-frontend",
    "dev:front": "npm run dev --prefix veterinaria-frontend/veterinaria-frontend",
    "install:all": "npm install && npm run install:front",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "keywords": [
    "veterinaria",
    "citas",
    "express",
    "postgresql"
  ],
  "author": "Santiago Buitrago Goyeneche, Sara Jasmin Cruz, Jorge Alejandro Paez",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "joi": "^17.13.3",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "nodemon": "^3.1.4",
    "vite": "^8.3.0"
  }
}
